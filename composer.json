{
    "name": "wai-blue/hubleto-ohs-documents",
    "license": "proprietary",
    "description": "Ohs for Hubleto: Working documents of clients, branches and audits with workflow states, priority and protected download",
    "require": {
        "wai-blue/hubleto-ohs-core": "dev-main",
        "wai-blue/hubleto-ohs-branches": "dev-main",
        "wai-blue/hubleto-ohs-audits": "dev-main"
    },
    "require-dev": {
        "hubleto/framework": "*",
        "hubleto/erp": "*",
        "hubleto/assets": "*",
        "hubleto/react-ui": "*"
    },
    "autoload": {
        "psr-4": {
            "Hubleto\\App\\External\\WaiBlue\\OhsDocuments\\": "src"
        }
    },
    "minimum-stability": "dev"
}
